# Official OpenClaw Gateway image. Pull before deployment.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.6.9
# Absolute path to a prepared benchmark dataset. No dataset is downloaded implicitly.
DATA_PATH=/absolute/path/to/locomo-small.json
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-chat-model
LLM_API_KEY=replace-me
# Judge configuration; may use the same model, but fill actual values.
LOCOMO_BASE_URL=https://your-provider.example/v1
LOCOMO_METRIC_MODEL=your-judge-model
LOCOMO_API_KEY=replace-me
PLUGIN_PATH=/absolute/path/to/official/plugin
MEMORY_IMAGE=your-openviking-image:tag
MEMORY_PORT=1933
MEMORY_CONFIG_PATH=/absolute/path/to/native-memory-config
MEMORY_CONFIG_TARGET=/etc/memory/config.yaml
MEMORY_DATA_TARGET=/data
MEMORY_API_KEY=replace-me
